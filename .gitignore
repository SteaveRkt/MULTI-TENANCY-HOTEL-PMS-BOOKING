.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtualenv
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Bases de données locales & SQLite ---
*.db
*.sqlite
*.sqlite3
backend/hotel.db
backend/test_hotel.db

# --- Node.js & Frontend (React / Vite) ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Déploiement & Cloud (Vercel, Render) ---
.vercel
.render

